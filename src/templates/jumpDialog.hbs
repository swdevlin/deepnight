<form>
  <fieldset>
    <div class="form-group">
      <label>{{localize "DEEPNIGHT.JumpDialog.From"}}</label>
      <div class="hint">{{fromSector}} {{fromHex}}</div>
    </div>
    <div class="form-group">
      <label for="sector">{{localize "DEEPNIGHT.Sector"}}
        {{#select currentSectorId}}
          <select name="sector" id="sector">
            {{#each sectors}}
              <option value="{{this.id}}">{{this.name}}</option>
            {{/each}}
          </select>
        {{/select}}
      </label>
    </div>
    <div class="form-group">
      <label for="hex">{{localize "DEEPNIGHT.Hex"}}
        <select id="hex" name="hex" disabled>
          <option value="">Select hex…</option>
        </select>
      </label>
    </div>
  </fieldset>
</form>
